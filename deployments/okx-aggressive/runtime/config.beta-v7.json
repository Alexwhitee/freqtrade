{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "liquidation_buffer": 0.15,
  "dry_run": true,
  "dry_run_wallet": 80,
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": 5,
  "tradable_balance_ratio": 0.50,
  "beta_v7_exit_policy": "channel_only",
  "fiat_display_currency": "USD",
  "exchange": {
    "name": "okx",
    "ccxt_config": {
      "enableRateLimit": true,
      "options": {
        "defaultType": "swap"
      }
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "options": {
        "defaultType": "swap"
      }
    },
    "pair_whitelist": [
      "QQQ/USDT:USDT",
      "AAPL/USDT:USDT",
      "AMZN/USDT:USDT",
      "GOOGL/USDT:USDT",
      "META/USDT:USDT",
      "MSFT/USDT:USDT",
      "NVDA/USDT:USDT",
      "TSLA/USDT:USDT",
      "BTC/USDT:USDT",
      "ETH/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "order_types": {
    "entry": "market",
    "exit": "market",
    "emergency_exit": "market",
    "force_entry": "market",
    "force_exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": true,
    "stoploss_on_exchange_interval": 60
  },
  "stoploss_price_type": "mark",
  "unfilledtimeout": {
    "entry": 1,
    "exit": 5,
    "unit": "minutes"
  },
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "CORS_origins": []
  },
  "bot_name": "okx_cross_asset_beta_v7",
  "initial_state": "running",
  "force_entry_enable": false,
  "internals": {
    "process_throttle_secs": 5,
    "heartbeat_interval": 60
  }
}
