# Copy to .env and chmod 600. Never commit the populated file.
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=
FREQTRADE__EXCHANGE__PASSWORD=
FREQTRADE__DRY_RUN=true

# Generate independent random values for the API password and JWT key.
FREQTRADE__API_SERVER__USERNAME=admin
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE__API_SERVER__JWT_SECRET_KEY=

# Risk guard uses HTTP Basic auth against the internal Freqtrade API.
RISK_GUARD_API_URL=http://freqtrade:8080/api/v1
RISK_GUARD_API_USERNAME=admin
RISK_GUARD_API_PASSWORD=
RISK_GUARD_STATE_PATH=/freqtrade/user_data/risk_guard/state.json
RISK_GUARD_INTERVAL_SECONDS=30
RISK_GUARD_AUTO_PROMOTE=true
# Keep false until aggregate sample-out-of-sample validation passes.
RISK_GUARD_VALIDATION_APPROVED=false
# A second explicit gate is required before V2 can place any live order.
RISK_GUARD_LIVE_APPROVED=false
# Keep false until S+ independently passes walk-forward/holdout validation.
RISK_GUARD_SPLUS_APPROVED=false

# V7 requires a separate explicit live approval and a persistent risk ledger.
BETA_V7_LIVE_APPROVED=false
BETA_V7_RISK_LEDGER_PATH=/freqtrade/user_data/risk_guard/beta-v7-risk-ledger.json
BETA_MARKET_SNAPSHOT_PATH=/freqtrade/user_data/okx_beta_markets.snapshot.json

# Optional until Telegram credentials are supplied.
FREQTRADE__TELEGRAM__ENABLED=false
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=
RISK_GUARD_TELEGRAM_TOKEN=
RISK_GUARD_TELEGRAM_CHAT_ID=
